<Window x:Class="VictusChargeControl.App.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Historial"
        Width="660"
        Height="540"
        MinWidth="560"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushBg}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Display">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Historial de eventos"
                   FontFamily="Segoe UI Variable Display, Segoe UI"
                   FontSize="22"
                   FontWeight="SemiBold" />

        <TextBlock Grid.Row="1"
                   Text="Registro de cambios, no mediciones continuas: no hay datos mientras la aplicación estuvo cerrada o el equipo suspendido."
                   Style="{StaticResource MutedText}"
                   TextWrapping="Wrap"
                   Margin="0,6,0,14" />

        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="FECHA" Style="{StaticResource LabelText}" />
                    <TextBlock Grid.Column="1" Text="CARGA" Style="{StaticResource LabelText}" />
                    <TextBlock Grid.Column="2" Text="ESTADO" Style="{StaticResource LabelText}" />
                    <TextBlock Grid.Column="3" Text="CORRIENTE" Style="{StaticResource LabelText}" />
                    <TextBlock Grid.Column="4" Text="EVENTO" Style="{StaticResource LabelText}" />
                </Grid>

                <TextBlock x:Name="EmptyText"
                           Grid.Row="1"
                           Text="Todavía no hay eventos registrados."
                           Style="{StaticResource MutedText}"
                           Margin="0,20,0,0"
                           Visibility="Collapsed" />

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <ItemsControl ItemsSource="{Binding}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Time}" FontSize="12" Foreground="{StaticResource BrushMuted}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Percent}" FontSize="12" />
                                    <TextBlock Grid.Column="2" Text="{Binding State}" FontSize="12" />
                                    <TextBlock Grid.Column="3" Text="{Binding Ac}" FontSize="12" Foreground="{StaticResource BrushMuted}" />
                                    <TextBlock Grid.Column="4" Text="{Binding Change}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cerrar"
                    Style="{StaticResource GhostButton}"
                    Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
